        },
        "purchaseOrderId": {
          "type": "string",
          "maxLength": 128
        },
        "khaltiPidx": {
          "type": "string",
          "maxLength": 128
        },
        "khaltiTxnId": {
          "type": "string",
          "maxLength": 128
        },
