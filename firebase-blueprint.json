{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public display profile for a verified FeedbackPulse user (contains no PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "nickname": {
          "type": "string",
          "maxLength": 60
        },
        "avatar": {
          "type": "string",
          "maxLength": 500
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["consumer"]
        },
        "accountMode": {
          "type": "string",
          "enum": ["customer", "company"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "banned", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly private PII and real wallet balance belonging to a single authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "walletBalance": {
          "type": "number"
        },
        "totalEarned": {
          "type": "number"
        },
        "preferredVoiceTone": {
          "type": "string",
          "maxLength": 40
        },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "other"]
        },
        "title": {
          "type": "string",
          "maxLength": 20
        },
        "lastWithdrawalRef": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "walletBalance", "totalEarned", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Admin directory entry for platform administrators.",
      "type": "object",
