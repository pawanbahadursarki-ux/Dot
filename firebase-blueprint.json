  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public user display profiles (no PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Strictly private user PII and real wallet balances."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Platform administrators list."
    },
    "/subscriptions/{userId}": {
      "schema": { "$ref": "#/entities/CompanySubscription" },
      "description": "Company subscriptions tied to user accounts."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Verified company subscription payment receipts."
    },
    "/payment_orders/{orderId}": {
      "schema": { "$ref": "#/entities/PaymentOrder" },
      "description": "Khalti Stage 1 manual QR and Stage 2 API checkout orders."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/KhaltiQrSetting" },
      "description": "Admin-managed Khalti QR and gateway mode configuration."
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/FeedbackSubmission" },
      "description": "Real customer smartphone feedback submissions and defect statuses."
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/WithdrawalRequest" },
      "description": "Real money withdrawal payout requests and settlements."
    },
    "/earnings_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/EarningsLedgerEntry" },
      "description": "Verified ledger of approved feedback rewards and withdrawal debits/refunds."
    }
  }
}
