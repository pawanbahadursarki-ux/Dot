        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "payerName",
        "planId",
        "planName",
        "billingCycle",
        "brandCategory",
        "amountUSD",
        "amountNPR",
        "method",
        "gateway",
        "referenceId",
        "status",
        "createdAt"
      ]
    },
